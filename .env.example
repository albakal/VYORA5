# SUPABASE_URL: Your Supabase project base URL (e.g., https://xyzcompany.supabase.co).
# Enter the actual value in the AI Studio Secrets panel or GitHub Secrets (never hardcode in source files).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SUPABASE_PUBLISHABLE_KEY: Your Supabase public/publishable (anon) key protected by PostgreSQL RLS.
# Enter the actual value in the AI Studio Secrets panel or GitHub Secrets (never hardcode in source files).
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# SUPABASE_STORAGE_BUCKET: Public/RLS-protected Storage bucket name for videos, thumbnails, avatars, and chat media.
SUPABASE_STORAGE_BUCKET=vyora-media

# SUPABASE_GOOGLE_WEB_CLIENT_ID: Optional Web OAuth Client ID configured in Supabase Google Auth provider.
# Keep the placeholder if using Email & Password authentication only.
SUPABASE_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID

# Security Notice:
# - NEVER put SUPABASE_SECRET_KEY / service_role key or AGORA_APP_CERTIFICATE in .env or inside the Android APK.
#   Configure server-only secrets strictly in Supabase Edge Function Secrets (`supabase secrets set`).
